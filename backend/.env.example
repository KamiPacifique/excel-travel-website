# Copy to .env and fill in. Never commit the real .env.

# Required — from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Where enquiries are delivered
CONTACT_TO=special.net1@gmail.com

# Who the email appears to come from. Must be an address on a domain verified
# at https://resend.com/domains — send.excel.rw is already verified.
MAIL_FROM=Excel Travel & Tours <noreply@send.excel.rw>

# Comma-separated sites allowed to POST to this API. No trailing slashes.
# If left empty the server falls back to the same three domains below.
# Localhost is accepted automatically unless NODE_ENV=production.
ALLOWED_ORIGINS=https://excel.rw,https://www.excel.rw,https://excel-travel-website.vercel.app

# Render sets PORT automatically; only used for local dev.
PORT=3000
